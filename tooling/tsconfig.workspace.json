{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable", "WebWorker"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "allowSyntheticDefaultImports": true,
    "useDefineForClassFields": true,
    "types": ["vitest/globals"]
  },
  "include": [
    "../apps/**/*.ts",
    "../apps/**/*.tsx",
    "../packages/**/*.ts",
    "../packages/**/*.tsx",
    "../vitest.config.ts"
  ],
  "exclude": ["../**/dist/**", "../**/node_modules/**"]
}
