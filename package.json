{
  "name": "wasm-first-workflow-editor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "build": "pnpm --filter demo-web-component build && pnpm --filter performance-lab build && pnpm --filter demo-react-host build",
    "demo:web-component": "pnpm --filter demo-web-component dev",
    "demo:performance-lab": "pnpm --filter performance-lab dev",
    "demo:react": "pnpm --filter demo-react-host dev",
    "serve:web-component": "pnpm --filter demo-web-component exec vite preview --host 127.0.0.1 --port 44173",
    "serve:performance-lab": "pnpm --filter performance-lab exec vite preview --host 127.0.0.1 --port 44175",
    "serve:react": "pnpm --filter demo-react-host exec vite preview --host 127.0.0.1 --port 44174",
    "preview:web-component": "pnpm --filter demo-web-component exec vite preview --host 127.0.0.1 --port 44173",
    "preview:performance-lab": "pnpm --filter performance-lab exec vite preview --host 127.0.0.1 --port 44175",
    "preview:react": "pnpm --filter demo-react-host exec vite preview --host 127.0.0.1 --port 44174",
    "bench:fixtures": "node tooling/scripts/generate-fixtures.mjs",
    "bench:smoke": "node tooling/scripts/bench-smoke.mjs",
    "lint": "pnpm typecheck",
    "typecheck": "pnpm --filter demo-web-component exec tsc --noEmit && pnpm --filter performance-lab exec tsc --noEmit && pnpm --filter demo-react-host exec tsc -b --pretty false",
    "test": "vitest run",
    "test:e2e": "node tooling/scripts/run-e2e.mjs",
    "wasm:build": "node tooling/scripts/build-wasm.mjs",
    "wasm:test": "cargo test --manifest-path packages/workflow-wasm-core/rust/Cargo.toml"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
